# Dev-only defaults. Copy to .env to override; nothing here is a real secret.
POSTGRES_USER=ivay
POSTGRES_PASSWORD=ivay_dev
POSTGRES_DB=ivay
POSTGRES_PORT=5432
API_PORT=8000
STATIC_PORT=8080

# API (compose builds this from the values above; set it yourself when running the API outside compose)
DATABASE_URL=postgresql+asyncpg://ivay:ivay_dev@localhost:5432/ivay
# Used by pytest; the database is created by scripts/local_db.sh or the CI service.
TEST_DATABASE_URL=postgresql+asyncpg://ivay:ivay_dev@localhost:5432/ivay_test

# Shopify order webhook secret for shop_dev (the shop row stores only this variable's name).
IVAY_WEBHOOK_SECRET_SHOP_DEV=
