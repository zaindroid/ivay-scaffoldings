{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shop-config.schema.json",
  "title": "Ivay shop config",
  "description": "Contract between the API config builder and the SDK. Version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "shop_id", "mode", "kill_switch", "holdout_bps",
    "holdout_salt", "log_endpoint", "required_consent", "consent_ping",
    "selectors", "url_patterns", "rules", "plays", "content"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "shop_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "mode": { "enum": ["shadow", "live"] },
    "kill_switch": { "type": "boolean" },
    "holdout_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "holdout_salt": { "type": "string", "minLength": 1 },
    "log_endpoint": { "type": "string", "pattern": "^https?://" },
    "required_consent": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "consent_ping": { "type": "boolean" },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shipping_block", "returns_block", "size_block",
        "size_chart_trigger", "variant_selector", "add_to_cart_form"
      ],
      "properties": {
        "shipping_block": { "$ref": "#/$defs/selector" },
        "returns_block": { "$ref": "#/$defs/selector" },
        "size_block": { "$ref": "#/$defs/selector" },
        "size_chart_trigger": { "$ref": "#/$defs/selector" },
        "variant_selector": { "$ref": "#/$defs/selector" },
        "add_to_cart_form": { "$ref": "#/$defs/selector" }
      }
    },
    "url_patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "cart", "shipping_policy", "returns_policy"],
      "properties": {
        "product": { "$ref": "#/$defs/selector" },
        "cart": { "$ref": "#/$defs/selector" },
        "shipping_policy": { "$ref": "#/$defs/selector" },
        "returns_policy": { "$ref": "#/$defs/selector" }
      }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "plays": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "$ref": "#/$defs/friction_state" },
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delivery_uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by_country": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Z]{2}$" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "returns_uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "shop": { "type": "string", "minLength": 1 } }
        },
        "sizing_uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "selector": { "type": "string", "minLength": 1 },
    "friction_state": {
      "enum": ["delivery_uncertainty", "returns_uncertainty", "sizing_uncertainty"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "priority", "friction_state", "pages", "when"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 0 },
        "friction_state": { "$ref": "#/$defs/friction_state" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["product", "cart"] }
        },
        "when": { "$ref": "#/$defs/condition" }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          }
        }
      ]
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f", "op", "v"],
      "properties": {
        "f": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "op": { "enum": ["eq", "gte", "lte", "gt", "lt"] },
        "v": { "type": ["boolean", "number", "string"] }
      }
    }
  }
}
